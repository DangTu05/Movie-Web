extends ../layouts/index.pug
block styles 
  link(rel='stylesheet', href='/assets/css/admin/create.css')
include ../partials/sidebar
include ../partials/header
block content
  .title
    h2=data.title || ""

  .card
    .card-body
      form(class="create-room-form", data-mode=data.title||"", room_id=(data.room ? data.room._id : ''))
        .form-group
          label(for="room_number") Số phòng:
          input#room_number.form-control(name="room_number", type="number" min= "1" value=(data.room ? data.room.room_number : ''), required)
        .form-group
          label(for="chair_total") Số lượng ghế tối đa:
          input#chair_total.form-control(name="chair_total", type="number" min= "1" value=(data.room ? data.room.chair_total : ''), required)
        .form-group.text-end
          button.btn.btn-primary.create-role-btn(type="submit")= data.title||""
  script(type="module", src="/js/admin/create-room.js") 
  //  SweetAlert2 CDN 